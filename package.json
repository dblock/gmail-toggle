{
  "name": "gmail-toggle",
  "version": "0.6.2",
  "description": "A Chrome extension that shows and hides the GMail labels, categories, and messages you've already read.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dblock/gmail-toggle.git"
  },
  "scripts": {
    "watch": "webpack --mode=development --watch --config config/webpack.config.js",
    "build": "webpack --mode=production --config config/webpack.config.js",
    "format": "prettier --write --ignore-unknown \"{config,public,src}/**/*.{html,css,js,ts,json}\"",
    "clean": "rm -rf build",
    "lint": "npm run lint:js && npm run lint:md && npm run lint:spelling",
    "lint:js": "eslint .",
    "lint:md": "markdownlint-cli2",
    "lint:spelling": "cspell --no-progress --gitignore .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "store-images": "node scripts/chrome-web-store-images.mjs",
    "video-music": "node scripts/video-music.mjs",
    "record-demo": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "gmail-js": "^1.1.17",
    "jquery": "^4.1.0",
    "versatile-tree": "^1.4.4"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/preset-env": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "babel-jest": "^30.5.2",
    "copy-webpack-plugin": "^14.0.0",
    "cspell": "^10.5.2",
    "css-loader": "^7.1.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "file-loader": "^6.2.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^31.0.1",
    "markdownlint-cli2": "^0.24.2",
    "mini-css-extract-plugin": "^2.10.2",
    "npm-package-release": "0.3.0",
    "prettier": "^3.10.1",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1",
    "webpack-merge": "^6.0.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "moduleDirectories": [
      "node_modules",
      "src"
    ]
  }
}
